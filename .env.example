# HMAC secret used to sign SafeMan QR credential payloads.
# MUST be set to a strong random value in production; the dev fallback is
# "oryx-safeman-dev-secret-2026" (see src/lib/qr-crypto.ts).
NEXT_PUBLIC_SAFEMAN_QR_SECRET=

# Optional. Fire-and-forget telemetry webhook — every issued certificate record
# is POSTed here as JSON. The site works 100% offline when left empty.
NEXT_PUBLIC_WEBHOOK_URL=
